<?xml version="1.0" encoding="utf-8" ?>
<job  name="MuMcAnalysis" minFilesPerProcess="1" maxFilesPerProcess="50"  filesPerHour="1" simulateSubmission="false" copyInputLocally="true" fileListSyntax="xrootd">

<Generator>
    <Location>./report/</Location>
    <ScriptLocation>./csh/</ScriptLocation>
    <ListLocation>./list/</ListLocation>
</Generator>


<stdout URL="file:&basePath;/jobs/log/$JOBID.out"/>
<stderr URL="file:&basePath;/jobs/err/$JOBID.err"/>
 
              
  
<command> 
  pwd
  set noPID=1 #ignore PID - usual behaviour
  set isPico=1 #pico - data, MuDst-embedding
  set isFXT=0

#processignal flag: {kAllTracks=0,kMcTracksOnly=1,kRealTracksOnly=2;
  set trkType=0
  
  #7p7 
  #set geometry=y2021
  
  #auau27GeV 2018 => y2018a
  #set geometry=y2018
  
  #auau19GeV 2019 => y2019
  set geometry=y2019
  
  #auau54
  #set geometry=y2017

  FXT 2020
  #set geometry=y2020
  
  #FXT 2021
  #set geometry=y2021
  
  #under TFG
  #source ./setDEV2.csh
  #starver TFG21d
  #starver TFG22f
  #starver TFG24c
  #starver TFG24e
  
  #under dev
  setup 64bits 
  starver dev
  echo CHP: after starver
  setup 64bits
  echo CHP: starting cons
  cons 
  echo CHP: after cons
  root4star -l -b -q kfpAnalysis.C\(2000000000,$trkType,$isPico,$isFXT,$noPID,\"${FILELIST}\",\"\${JOBID}.root\",\"${geometry}\"\) &gt;&amp; ${SCRATCH}/${JOBID}B.log
#         root4star -l -b -q kfpAnalysis.C\(50,$trkType,$isPico,$isFXT,$noPID,\"${FILELIST}\",\"\${JOBID}.root\",\"${geometry}\"\) &gt;&amp; ${SCRATCH}/${JOBID}B.log
</command>

<output fromScratch="*.root"    toURL="&basePath;/production/" />
<output fromScratch="*.log"     toURL="&basePath;/jobs/log/" /> 
  
